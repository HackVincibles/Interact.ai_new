# ===================================================
# INTERACT.AI OFFICIAL ENVIRONMENT VARIABLES TEMPLATE
# ===================================================

# 1. Google Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key"
VITE_GEMINI_API_KEY="your-gemini-api-key"

# 2. Supabase Configuration & PostgreSQL DB
VITE_SUPABASE_URL="https://your-supabase-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
DATABASE_URL="postgresql://postgres:password@db.your-supabase-id.supabase.co:5432/postgres"

# 3. Web Intelligence & Scraping API Keys
TINYFISH_API_KEY="sk-tinyfish-your-key"
FIRECRAWL_API_KEY="fc-your-key"

# 4. Upstash Redis (Leaderboards & Cache)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
VITE_UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
VITE_UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# 5. Cashfree Payment Gateway (Sandbox / Test Mode)
CASHFREE_APP_ID="TEST_app_id"
CASHFREE_SECRET_KEY="TEST_secret_key"
CASHFREE_API_URL="https://sandbox.cashfree.com/pg"
VITE_CASHFREE_APP_ID="TEST_app_id"
VITE_CASHFREE_ENV="TEST"

# 6. SendGrid Email & OTP Service
SENDGRID_API_KEY="SG.your-sendgrid-key"

# 7. Code Execution Engine (Piston Public API)
PISTON_API_URL="https://emkc.org/api/v2/piston"
VITE_PISTON_API_URL="https://emkc.org/api/v2/piston"

# 8. Vapi Voice AI Interview Engine
VITE_VAPI_PUBLIC_KEY="your-vapi-public-key"
VITE_VAPI_ASSISTANT_ID="your-vapi-assistant-id"
VAPI_PRIVATE_KEY="your-vapi-private-key"

